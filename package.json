{
  "name": "@dosgato/dialog-ckeditor",
  "description": "A form control that provides an instance of CKEditor. Designed to be compatible with @dosgato/dialog.",
  "version": "1.1.6",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "svelte-package",
    "dev": "vite dev",
    "devck": "cp -R ~/git/dosgato-ckeditor/build node_modules/@dosgato/ckeditor && rm -rf node_modules/.vite && vite dev",
    "package": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dosgato/ckeditor": "^1.2.6",
    "@dosgato/dialog": "^1.3.6",
    "@iconify-icons/mdi": "^1.2.38",
    "@txstate-mws/svelte-forms": "^2.0.0",
    "txstate-utils": "^1.8.3"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-core": "^41.4.2",
    "@ckeditor/ckeditor5-editor-classic": "^41.4.2",
    "@eslint/compat": "^2.0.3",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.0.0",
    "eslint-config-love": "^154.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "sass": "^1.58.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "svelte": "^3.55.1 || ^4.0.0 || ^5.0.0"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "author": "Nick Wing",
  "license": "GPL-2.0-or-later",
  "bugs": "https://github.com/txstate-etc/dosgato-dialog-ckeditor/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/txstate-etc/dosgato-dialog-ckeditor.git"
  }
}
